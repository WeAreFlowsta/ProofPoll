{
  "name": "proofpoll",
  "description": "ProofPoll - Verified polls with Flowsta identity linking",
  "version": "0.6.0-beta.2",
  "license": "MIT",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build -c adapters/static/vite.config.ts && node scripts/check-test-features.mjs",
    "build.client": "vite build",
    "dev": "vite --mode ssr",
    "fmt": "prettier --write .",
    "lint": "eslint \"src/**/*.ts*\"",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "tauri": "tauri",
    "e2e:build": "FEATURES=e2e scripts/build-test-binary.sh",
    "e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.19.0",
    "@builder.io/qwik-city": "^1.19.0",
    "@tailwindcss/vite": "^4.2.0",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "20.19.0",
    "@wdio/cli": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "prettier": "3.6.2",
    "tailwindcss": "^4.2.0",
    "tsx": "~4.23.15",
    "typescript": "5.4.5",
    "typescript-plugin-css-modules": "latest",
    "undici": "*",
    "vite": "7.3.2",
    "vite-tsconfig-paths": "^4.2.1",
    "webdriverio": "^9.33.1"
  },
  "dependencies": {
    "@flowsta/holochain": "^3.5.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tauri-apps/plugin-shell": "^2.3.5"
  }
}
